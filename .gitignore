# @file .gitignore
# @brief Excludes generated build products, editor state, and local analysis output.

/build*/
/out/
/Testing/
*.profraw
*.profdata
*.sarif
.cache/
.idea/
.vscode/
__pycache__/

# Native application builds, dependencies and isolated synthetic workspaces stay private.
/.runtime/
/web/node_modules/
/web/build/
/web/dist/
/web/test-results/
/web/playwright-report/
/.venv/
/.coverage*
.pytest_cache/
.ruff_cache/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
