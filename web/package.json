{
  "name": "industrial-memory-protocol-workbench-ui",
  "version": "1.1.0",
  "private": true,
  "description": "Offline original C++ protocol session and exact-byte evidence UI",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test build/tests/*.test.js",
    "check:browser-host": "node scripts/check_browser_host.mjs chromium",
    "test:browser": "python ../tools/smoke_source.py --output ../.runtime/source-browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
